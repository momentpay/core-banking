# Mix build output and fetched dependencies
/_build/
/deps/
/cover/
/doc/
/.fetch
*.ez
erl_crash.dump
/tmp/

# Compiled assets and digest manifest
/apps/*/priv/static/assets/
/apps/*/priv/static/cache_manifest.json

# Node
npm-debug.log
/apps/*/assets/node_modules/

# Local secrets and overrides. Never commit these.
.env
.env.*
!.env.example
*.pem
*.key

# Editor and OS files
.elixir_ls/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Parity harness output (reports, downloaded Fineract builds)
/parity/.cache/
/parity/reports/

# Python bytecode (parity tools)
__pycache__/
*.pyc
